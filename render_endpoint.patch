+@router.get("/{incident_id}/render")
+def render_incident(incident_id: str, db: Session = Depends(get_db)):
+    incident = db.query(Incident).filter(Incident.id == uuid.UUID(incident_id)).first()
+    if not incident:
+        raise HTTPException(status_code=404, detail="Incident not found")
+    return {"rendered": render_notification(db, incident, "triggered")}
