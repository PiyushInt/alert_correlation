APP_NAME="ace"
APP_VERSION="0.1.0"
DEBUG=False
DATABASE_URL="postgresql+psycopg://ace_user:ace_password@localhost:5433/ace_db"
REDIS_URL="redis://localhost:6380/0"

MAX_INCIDENT_HOPS=3
MAX_INCIDENT_ALERTS=500
MAX_PIPELINE_LAG=300
CANARY_INTERVAL=60
CANARY_TIMEOUT=120
CRITICAL_BYPASS_SEVERITY="critical"
CORRELATION_WINDOW=300
DEDUP_WINDOW=3600
FLAP_WINDOW=900
FUZZY_MATCH_THRESHOLD=0.85
MIN_MAP_COVERAGE=0.7
